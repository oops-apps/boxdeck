{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boxdeck",
  "version": "0.1.0-beta.4",
  "identifier": "io.github.oops-apps.boxdeck",
  "build": {
    "beforeDevCommand": "node scripts/build-sidecar.mjs --debug && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/build-sidecar.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Boxdeck",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5MkU4MDVDMkZEMkM3N0MKUldSOHg5SXZYSUF1cWRYZDhDK3V0VW03K2F0TjJPUnUzOE9VcVFaRHpSdGoyN2t3d0JrZWRRam0K",
      "endpoints": [
        "https://github.com/oops-apps/boxdeck/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/boxdeck-mcp"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Desktop GUI for HashiCorp Vagrant",
    "copyright": "Copyright (c) 2026 oops-apps. MIT License.",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
